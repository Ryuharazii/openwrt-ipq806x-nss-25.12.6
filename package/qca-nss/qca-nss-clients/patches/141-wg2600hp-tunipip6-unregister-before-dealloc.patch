From: WG2600HP 25.12.6 NSS integration
Subject: [PATCH] tunipip6: unregister NSS interfaces before dealloc ACK invalidates type

The pinned NSS driver uses the dynamic interface type for
nss_unregister_tunipip6_if() validation. A successful dealloc ACK
sets that type to NONE; unregistering afterwards violates the check.
Unregister first, as done by the related NSS tun6rd client.

This addresses teardown ordering, not firmware acceleration proof.
On dealloc NACK the node may remain allocated; do not treat it as
successful teardown without an ACK.

--- a/tunipip6/nss_connmgr_tunipip6.c
+++ b/tunipip6/nss_connmgr_tunipip6.c
@@ -418,14 +418,14 @@
 	}
 
-	status = nss_dynamic_interface_dealloc_node(inner_ifnum, NSS_DYNAMIC_INTERFACE_TYPE_TUNIPIP6_INNER);
-	if (status != NSS_TX_SUCCESS) {
-		nss_tunipip6_warning("%px: Dealloc inneer node failure\n", netdev);
-		return NSS_CONNMGR_TUNIPIP6_TUN_DESTROY_FAILURE;
-	}
-
-	/*
-	 * Un-Register IPIP6 tunnel with NSS
-	 */
-	nss_unregister_tunipip6_if(inner_ifnum);
+	/*
+	 * Unregister before dealloc ACK clears the dynamic interface type.
+	 */
+	nss_unregister_tunipip6_if(inner_ifnum);
+	status = nss_dynamic_interface_dealloc_node(inner_ifnum, NSS_DYNAMIC_INTERFACE_TYPE_TUNIPIP6_INNER);
+	if (status != NSS_TX_SUCCESS) {
+		nss_tunipip6_warning("%px: Dealloc inneer node failure\n", netdev);
+		return NSS_CONNMGR_TUNIPIP6_TUN_DESTROY_FAILURE;
+	}
+
 
 	outer_ifnum = nss_cmn_get_interface_number_by_dev_and_type(netdev, NSS_DYNAMIC_INTERFACE_TYPE_TUNIPIP6_OUTER);
@@ -435,14 +435,14 @@
 	}
 
-	status = nss_dynamic_interface_dealloc_node(outer_ifnum, NSS_DYNAMIC_INTERFACE_TYPE_TUNIPIP6_OUTER);
-	if (status != NSS_TX_SUCCESS) {
-		nss_tunipip6_warning("%px: Dealloc outer node failure\n", netdev);
-		return NSS_CONNMGR_TUNIPIP6_TUN_DESTROY_FAILURE;
-	}
-
-	/*
-	 * Un-Register IPIP6 tunnel with NSS
-	 */
-	nss_unregister_tunipip6_if(outer_ifnum);
+	/*
+	 * Unregister before dealloc ACK clears the dynamic interface type.
+	 */
+	nss_unregister_tunipip6_if(outer_ifnum);
+	status = nss_dynamic_interface_dealloc_node(outer_ifnum, NSS_DYNAMIC_INTERFACE_TYPE_TUNIPIP6_OUTER);
+	if (status != NSS_TX_SUCCESS) {
+		nss_tunipip6_warning("%px: Dealloc outer node failure\n", netdev);
+		return NSS_CONNMGR_TUNIPIP6_TUN_DESTROY_FAILURE;
+	}
+
 
 	return NSS_CONNMGR_TUNIPIP6_SUCCESS;
