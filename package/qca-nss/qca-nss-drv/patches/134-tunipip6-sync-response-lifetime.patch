+/*
+ * nss_tunipip6_callback()
+ * Ignore a response if its synchronous request has timed out or finished.
+ */
+static void nss_tunipip6_callback(void *app_data, struct nss_tunipip6_msg *nclm)
+{
+	u32 generation = (u32)(unsigned long)app_data;
+
+	spin_lock_bh(&tunipip6_pvt.lock);
+	if (!tunipip6_pvt.pending || generation != tunipip6_pvt.generation) {
+		spin_unlock_bh(&tunipip6_pvt.lock);
+		return;
+	}
+
+	tunipip6_pvt.response = NSS_TX_SUCCESS;
+	if (nclm->cm.response != NSS_CMN_RESPONSE_ACK) {
+		nss_warning("tunipip6 sync NACK response %d error %d\n", nclm->cm.response, nclm->cm.error);
+		tunipip6_pvt.response = NSS_TX_FAILURE;
+	}
+	tunipip6_pvt.pending = false;
+	complete(&tunipip6_pvt.complete);
+	spin_unlock_bh(&tunipip6_pvt.lock);
+}
+
+/*
+ * nss_tunipip6_tx_sync()
+ * A fresh completion and monotonically increasing token for each request.
+ */
+nss_tx_status_t nss_tunipip6_tx_sync(struct nss_ctx_instance *nss_ctx, struct nss_tunipip6_msg *msg)
+{
+	nss_tx_status_t status;
+	int ret;
+
+	down(&tunipip6_pvt.sem);
+	spin_lock_bh(&tunipip6_pvt.lock);
+	if (++tunipip6_pvt.generation == 0)
+		++tunipip6_pvt.generation;
+	reinit_completion(&tunipip6_pvt.complete);
+	tunipip6_pvt.response = NSS_TX_FAILURE;
+	tunipip6_pvt.pending = true;
+	msg->cm.cb = (nss_ptr_t)nss_tunipip6_callback;
+	msg->cm.app_data = (nss_ptr_t)(unsigned long)tunipip6_pvt.generation;
+	spin_unlock_bh(&tunipip6_pvt.lock);
+
+	status = nss_tunipip6_tx(nss_ctx, msg);
+	if (status == NSS_TX_SUCCESS) {
+		ret = wait_for_completion_timeout(&tunipip6_pvt.complete,
+					msecs_to_jiffies(NSS_TUNIPIP6_TX_TIMEOUT));
+		if (!ret)
+			nss_warning("%px: tunipip6 tx sync timeout\n", nss_ctx);
+		spin_lock_bh(&tunipip6_pvt.lock);
+		status = ret ? tunipip6_pvt.response : NSS_TX_FAILURE;
+		spin_unlock_bh(&tunipip6_pvt.lock);
+	} else {
+		nss_warning("%px: tunipip6 tx failed\n", nss_ctx);
+	}
+
+	spin_lock_bh(&tunipip6_pvt.lock);
+	tunipip6_pvt.pending = false;
+	spin_unlock_bh(&tunipip6_pvt.lock);
+	up(&tunipip6_pvt.sem);
+	return status;
+}
+EXPORT_SYMBOL(nss_tunipip6_tx_sync);
 
