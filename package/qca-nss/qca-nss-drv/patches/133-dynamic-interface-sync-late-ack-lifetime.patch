-	}
-
-	return status;
-}
+static nss_tx_status_t nss_dynamic_interface_tx_sync(struct nss_ctx_instance *nss_ctx, struct nss_dynamic_interface_msg_data *di_data,
+						     struct nss_dynamic_interface_msg *ndim)
+{
+	nss_tx_status_t status;
+	int ret = 0;
+
+	/*
+	 * This mutex serializes synchronous requests, while the token makes
+	 * out-of-order or timed-out callbacks harmless to the next request.
+	 */
+	mutex_lock(&nss_dynamic_interface_sync_mutex);
+	spin_lock_bh(&nss_dynamic_interface_sync_lock);
+	nss_dynamic_interface_sync_generation++;
+	if (!nss_dynamic_interface_sync_generation) {
+		nss_dynamic_interface_sync_generation++;
+	}
+	nss_dynamic_interface_sync_data.if_num = -1;
+	nss_dynamic_interface_sync_data.response = -1;
+	init_completion(&nss_dynamic_interface_sync_data.complete);
+	nss_dynamic_interface_sync_pending = true;
+	ndim->cm.app_data = (nss_ptr_t)(unsigned long)nss_dynamic_interface_sync_generation;
+	spin_unlock_bh(&nss_dynamic_interface_sync_lock);
+
+	status = nss_dynamic_interface_tx(nss_ctx, ndim);
+	if (status != NSS_TX_SUCCESS) {
+		nss_warning("%px: not able to transmit msg successfully\n", nss_ctx);
+		goto done;
+	}
+
+	ret = wait_for_completion_timeout(&nss_dynamic_interface_sync_data.complete,
+					  msecs_to_jiffies(NSS_DYNAMIC_INTERFACE_COMP_TIMEOUT));
+	if (!ret) {
+		nss_warning("%px: Waiting for ack timed out\n", nss_ctx);
+		status = NSS_TX_FAILURE;
+	}
+
+done:
+	spin_lock_bh(&nss_dynamic_interface_sync_lock);
+	if (ret) {
+		di_data->response = nss_dynamic_interface_sync_data.response;
+		di_data->if_num = nss_dynamic_interface_sync_data.if_num;
+	}
+	nss_dynamic_interface_sync_pending = false;
+	spin_unlock_bh(&nss_dynamic_interface_sync_lock);
+	mutex_unlock(&nss_dynamic_interface_sync_mutex);
+	return status;
+}
 
