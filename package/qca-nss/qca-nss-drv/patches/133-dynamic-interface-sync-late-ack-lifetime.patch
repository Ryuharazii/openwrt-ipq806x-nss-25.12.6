+struct nss_dynamic_interface_msg_data {
+	struct completion complete;	/* completion structure */
+	int if_num;			/* Interface number */
+	enum nss_cmn_response response;	/* Message response */
+};
+
+/*
+ * Protect callback lifetime after timeout without retaining heap allocations.
+ * Serialize synchronous requests and reject late responses via generation IDs.
+ */
+static DEFINE_MUTEX(nss_dynamic_interface_sync_mutex);
+static DEFINE_SPINLOCK(nss_dynamic_interface_sync_lock);
+static struct nss_dynamic_interface_msg_data nss_dynamic_interface_sync_data;
+static uint32_t nss_dynamic_interface_sync_generation;
+static bool nss_dynamic_interface_sync_pending;
 
 static nss_dynamic_interface_assigned nss_dynamic_interface_assigned_types[NSS_CORE_MAX][NSS_MAX_DYNAMIC_INTERFACES]; /* Array of assigned interface types */
 
@@ -128,19 +140,25 @@
  * nss_dynamic_interface_callback
  *	Callback to handle the message response from NSS FW.
  */
-static void nss_dynamic_interface_callback(void *app_data, struct nss_cmn_msg *ncm)
-{
-	struct nss_dynamic_interface_msg_data *di_data = (struct nss_dynamic_interface_msg_data *)app_data;
-	struct nss_dynamic_interface_msg *ndim = (struct nss_dynamic_interface_msg *)ncm;
-
-	di_data->response = ncm->response;
-	di_data->if_num = ndim->msg.alloc_node.if_num;
-
-	/*
-	 * Unblock the sleeping function.
-	 */
-	complete(&di_data->complete);
-}
+static void nss_dynamic_interface_callback(void *app_data, struct nss_cmn_msg *ncm)
+{
+	struct nss_dynamic_interface_msg_data *di_data = &nss_dynamic_interface_sync_data;
+	struct nss_dynamic_interface_msg *ndim = (struct nss_dynamic_interface_msg *)ncm;
+	uint32_t generation = (uint32_t)(unsigned long)app_data;
+
+	spin_lock_bh(&nss_dynamic_interface_sync_lock);
+	if (!nss_dynamic_interface_sync_pending ||
+	    generation != nss_dynamic_interface_sync_generation) {
+		spin_unlock_bh(&nss_dynamic_interface_sync_lock);
+		return;
+	}
+
+	nss_dynamic_interface_sync_pending = false;
+	di_data->response = ncm->response;
+	di_data->if_num = ndim->msg.alloc_node.if_num;
+	complete(&di_data->complete);
+	spin_unlock_bh(&nss_dynamic_interface_sync_lock);
+}
 
 /*
  * nss_dynamic_interface_tx()
@@ -175,29 +193,53 @@
