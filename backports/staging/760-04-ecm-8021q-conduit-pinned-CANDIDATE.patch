 EXPORT_SYMBOL(ecm_interface_get_and_hold_dev_master);
 
-/*
- * ecm_interface_vlan_real_dev()
- *	Return immediate VLAN net device or Physical device pointer
- */
-static inline struct net_device *ecm_interface_vlan_real_dev(struct net_device *vlan_dev)
-{
-	return vlan_dev_next_dev(vlan_dev);
-}
+#ifdef ECM_INTERFACE_VLAN_ENABLE
+#if IS_ENABLED(CONFIG_NET_DSA)
+/* Return the physical conduit only for ports using the 802.1Q DSA tagger. */
+static struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
+{
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return NULL;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR_OR_NULL(dp) || !dp->ds || !dp->ds->tag_8021q_ctx ||
+	    !dp->cpu_dp || !dp->cpu_dp->conduit)
+		return NULL;
+
+	if (vid) {
+		if (dp->bridge && dp->bridge->tx_fwd_offload)
+			*vid = dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+		else
+			*vid = dsa_tag_8021q_standalone_vid(dp);
+	}
+	return dp->cpu_dp->conduit;
+}
+#else
+static inline struct net_device *ecm_interface_dsa_8021q_conduit(struct net_device *dev, uint16_t *vid)
+{
+	return NULL;
+}
+#endif
+
+static inline bool ecm_interface_is_vlan_dev(struct net_device *dev)
+{
+	return is_vlan_dev(dev) || ecm_interface_dsa_8021q_conduit(dev, NULL);
+}
+#endif
+
+/*
+ * ecm_interface_vlan_real_dev()
+ *	Return immediate VLAN net device or Physical device pointer
+ */
+static inline struct net_device *ecm_interface_vlan_real_dev(struct net_device *vlan_dev)
+{
+#ifdef ECM_INTERFACE_VLAN_ENABLE
+	if (is_vlan_dev(vlan_dev)) {
+		struct net_device *real = vlan_dev_next_dev(vlan_dev);
+		struct net_device *conduit = ecm_interface_dsa_8021q_conduit(real, NULL);
+		return conduit ? conduit : real;
+	}
+	return ecm_interface_dsa_8021q_conduit(vlan_dev, NULL);
+#else
+	return vlan_dev_next_dev(vlan_dev);
+#endif
+}
 
