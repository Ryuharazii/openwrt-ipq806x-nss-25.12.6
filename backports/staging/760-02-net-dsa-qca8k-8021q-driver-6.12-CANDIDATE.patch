+/* Where the switch floods broadcast, multicast and unknown unicast. With
+ * the Atheros header every frame from the CPU names its destination ports
+ * and skips the lookup, so flooding only ever has to reach the CPU. Under
+ * qca-8021q the CPU sends a bridge's flood once, in the bridge's VLAN, and
+ * the switch spreads it, so the masks open to the user ports and the VLAN
+ * table keeps a flood inside its VLAN. A bridge port with one kind of flood
+ * off leaves that mask. The masks are global: such a port gets none of
+ * that flood, from the CPU either.
+ */
+int qca8k_write_flood_masks(struct qca8k_priv *priv, bool tag_8021q)
+{
+	struct dsa_switch *ds = priv->ds;
+	u32 cpu = dsa_cpu_ports(ds);
+	u32 user = tag_8021q ? dsa_user_ports(ds) : 0;
+	u32 uc = cpu | (user & ~priv->port_uc_flood_off);
+	u32 mc = cpu | (user & ~priv->port_mc_flood_off);
+	u32 bc = cpu | (user & ~priv->port_bc_flood_off);
+
+	return qca8k_write(priv, QCA8K_REG_GLOBAL_FW_CTRL1,
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_IGMP_DP_MASK, mc) |
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_BC_DP_MASK, bc) |
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_MC_DP_MASK, mc) |
+			   FIELD_PREP(QCA8K_GLOBAL_FW_CTRL1_UC_DP_MASK, uc));
+}
