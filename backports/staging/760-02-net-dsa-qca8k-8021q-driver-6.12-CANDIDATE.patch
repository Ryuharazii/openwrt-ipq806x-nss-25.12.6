+/* Under tag_8021q every lookup happens in the port's tag_8021q VLAN,
+ * so an entry the bridge hands over without a VID has to go there and
+ * not to the port default VID, where nothing would ever find it. The
+ * DSA core zeroes db.bridge.num for a switch without FDB isolation, so
+ * the number of the bridge is taken from a port that is in it.
+ */
+static u16 qca8k_db_vid(struct qca8k_priv *priv, struct dsa_db db, u16 vid)
+{
+	struct dsa_port *dp;
+
+	if (vid || priv->tag_proto != DSA_TAG_PROTO_QCA_8021Q)
+		return vid;
+
+	switch (db.type) {
+	case DSA_DB_BRIDGE:
+		dsa_switch_for_each_user_port(dp, priv->ds)
+			if (dsa_port_offloads_bridge_dev(dp, db.bridge.dev))
+				return dsa_tag_8021q_bridge_vid(dp->bridge->num);
+		return vid;
+	case DSA_DB_PORT:
+		return dsa_tag_8021q_standalone_vid(db.dp);
+	default:
+		return vid;
+	}
+}
