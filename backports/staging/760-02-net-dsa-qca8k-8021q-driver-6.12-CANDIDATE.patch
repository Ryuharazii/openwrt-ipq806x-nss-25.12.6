+	pvid = vlan_aware ? priv->bridge_pvid[port] : priv->tag_8021q_pvid[port];
+
+	/* No PVID yet (a bridge's VLANs come after vlan_filtering): the
+	 * register keeps what it has until one arrives.
+	 */
+	if (!pvid)
+		return 0;
+
+	return qca8k_port_set_pvid(priv, port, pvid);
+}
