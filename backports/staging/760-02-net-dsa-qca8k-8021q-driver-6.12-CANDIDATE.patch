+	struct qca8k_priv *priv = ds->priv;
+	unsigned long supported = BR_LEARNING | BR_ISOLATED;
+
+	/* Under qca-8021q the switch floods for the bridge */
+	if (priv->tag_proto == DSA_TAG_PROTO_QCA_8021Q)
+		supported |= BR_FLOOD | BR_MCAST_FLOOD | BR_BCAST_FLOOD;
+
+	if (flags.mask & ~supported)
 		return -EINVAL;
 
 	return 0;
 }
 
+static void qca8k_flood_off_update(u8 *map, int port,
+				   struct switchdev_brport_flags flags,
+				   unsigned long flag)
+{
+	if (!(flags.mask & flag))
+		return;
+
+	if (flags.val & flag)
+		*map &= ~BIT(port);
+	else
+		*map |= BIT(port);
+}
