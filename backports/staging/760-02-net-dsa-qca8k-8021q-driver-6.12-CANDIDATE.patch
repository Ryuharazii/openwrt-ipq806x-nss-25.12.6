+int qca8k_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+			     u16 flags)
+{
+	bool untagged = flags & BRIDGE_VLAN_INFO_UNTAGGED;
+	bool pvid = flags & BRIDGE_VLAN_INFO_PVID;
+	struct qca8k_priv *priv = ds->priv;
+	int ret;
+
+	ret = qca8k_vlan_add(priv, port, vid, untagged);
+	if (ret) {
+		dev_err(priv->dev, "Failed to add tag_8021q VLAN %d to port %d (%d)",
+			vid, port, ret);
+		return ret;
 	}
 
+	if (pvid) {
+		priv->tag_8021q_pvid[port] = vid;
+		ret = qca8k_commit_pvid(ds, port,
+					dsa_port_is_vlan_filtering(dsa_to_port(ds, port)));
+	}
+
 	return ret;
 }
 
+int qca8k_tag_8021q_vlan_del(struct dsa_switch *ds, int port, u16 vid)
+{
+	struct qca8k_priv *priv = ds->priv;
+	int ret;
+
+	ret = qca8k_vlan_del(priv, port, vid);
+	if (ret)
+		dev_err(priv->dev, "Failed to delete tag_8021q VLAN %d from port %d (%d)",
+			vid, port, ret);
+
+	return ret;
+}
