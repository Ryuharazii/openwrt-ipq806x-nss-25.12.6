+/* Is this VID a VLAN of a VLAN-aware bridge that @port is not in? The
+ * tagger picks the bridge by the VID alone, so one VID cannot serve two.
+ */
+static bool qca8k_vlan_in_other_bridge(struct dsa_switch *ds, int port,
+				       u16 vid)
+{
+	struct dsa_port *dp = dsa_to_port(ds, port), *other;
+	struct bridge_vlan_info vinfo;
+	bool found = false;
+
+	rcu_read_lock();
+	dsa_switch_for_each_user_port(other, ds) {
+		if (!other->bridge || !other->user ||
+		    dsa_port_bridge_same(dp, other))
+			continue;
+		if (!br_vlan_get_info_rcu(other->user, vid, &vinfo)) {
+			found = true;
+			break;
+		}
+	}
+	rcu_read_unlock();
+
+	return found;
+}
